# ---------------------------------------------------------------------------
# Copy to `.env` and fill in.  `.env` is git-ignored; never commit real keys.
# ---------------------------------------------------------------------------

# Which provider to use: `anthropic` | `deepseek` | `offline`
LLM_PROVIDER=anthropic

# Anthropic-compatible access (Claude Opus variants, etc.)
ANTHROPIC_API_KEY=
# Model id is verified against the provider's model list at runtime.
# `python -m eeg_research_agent.cli llm-check` prints the models your key can see.
LLM_MODEL=

# DeepSeek-compatible access (DeepSeek chat / "flash"-style reasoning variants)
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com

# Optional: override endpoints for proxies / gateways
ANTHROPIC_BASE_URL=https://api.anthropic.com

# Optional: how many papers the literature agent should aim for
LITERATURE_TARGET_PAPERS=25

# Optional: force the deterministic offline reasoning provider (no network, no key)
EEG_AGENT_FORCE_OFFLINE_LLM=0
