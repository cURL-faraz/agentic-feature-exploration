# Copy to `.env` (cp .env.example .env) and fill in. `.env` is git-ignored; never commit real keys.

# --- required for the LLM agents (everything else runs without it) ---------------
# Get a key at https://openrouter.ai/keys - free models need no credits
# (free tier: ~20 requests/min, ~50 requests/day; more if the account has credits).
OPENROUTER_API_KEY=

# --- optional ---------------------------------------------------------------------
# Model(s) tried first by every agent role (scout, inventor, critic). Comma-separate
# several to set your own fallback order; the per-role lists in
# src/featurelab/default_config.yaml remain as further fallbacks.
# Leave empty to use those per-role lists only.
FEATURELAB_LLM_MODEL=nvidia/nemotron-3.5-super-vl:free

# Where raw data, caches, the ledger and run reports live (default: ./data/featurelab).
# Docker ignores this and always uses /data (mounted from ./data/featurelab).
# FEATURELAB_DATA=/absolute/path/to/featurelab-data
