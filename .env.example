# Copy to `.env` and fill in. `.env` is git-ignored; never commit real keys.
# Get a key at https://openrouter.ai/keys - free models need no credits
# (free tier: ~20 requests/min, ~50 requests/day; more if the account has credits).
OPENROUTER_API_KEY=

# Where raw data, caches, the ledger and run reports live (default: ./data/featurelab)
# FEATURELAB_DATA=/absolute/path/to/featurelab-data
