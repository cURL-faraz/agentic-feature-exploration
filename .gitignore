# ---- secrets ----
.env
.env.*
!.env.example

# ---- python ----
__pycache__/
*.py[cod]
*.egg-info/
.eggs/
build/
dist/
.venv/
venv/
.mypy_cache/
.pytest_cache/
.ruff_cache/
.coverage
htmlcov/

# ---- conda (local, environment-specific) ----
.conda/

# ---- git directory used by the sandboxed build ----
# The reference sandbox forbids creating ./.git, so the repository metadata was
# written to ./.gitstore.  Rename it to .git (mv .gitstore .git) to get a
# completely standard repository.
.gitstore/

# ---- notebooks ----
.ipynb_checkpoints/

# ---- data: never commit raw / derived clinical data ----
data/raw/*
!data/raw/.gitkeep
data/interim/*
!data/interim/.gitkeep
data/processed/*
!data/processed/.gitkeep
data/features/*
!data/features/.gitkeep
# derived metadata (dataset summary, split manifest, bibliography, verification
# report) is regenerated by `cli run`; only the directory is tracked
data/metadata/*
!data/metadata/.gitkeep

# ---- large generated artifacts ----
artifacts/figures/*
artifacts/tables/*
!artifacts/figures/.gitkeep
!artifacts/tables/.gitkeep
artifacts/execution_logs/*
!artifacts/execution_logs/.gitkeep
*.parquet
*.h5
*.fif
*.edf
*.bdf
